# Copy this to discord/.env (or add alongside the other bots' vars there)
# and fill in STAT_BOT_TOKEN. discord/.env is gitignored.

STAT_BOT_TOKEN=your_stat_bot_token_here
# Base URL of the dashboard-api service. Defaults to the docker-compose
# internal hostname (http://dashboard-api:8090) -- override for local dev
# against a locally-running `uvicorn dashboard_site.api.app:app --port 8090`.
DASHBOARD_API_BASE_URL=http://localhost:8090
# Where daily_games_history.csv / cursor / last-run state live (see
# discord/daily_games.py). Defaults to shared/runtime_config.py's
# DEFAULT_DATA_ROOT -- override to the droplet's persistent data volume in
# production (matches feature-bot's FANTASY_DATA_ROOT).
FANTASY_DATA_ROOT=/srv/unisfantasy/data
