# Copy this to discord/.env (or add alongside the existing bot's vars there)
# and fill in FEATURE_BOT_TOKEN. discord/.env is gitignored.

FEATURE_BOT_TOKEN=your_feature_bot_token_here

# --- Weekly role sync (Top 6 / Champs / Current Champ) ---
# Required -- there's no incoming message/interaction to infer the guild
# from for a scheduled job, unlike every other handler in this file.
# Right-click the server icon -> Copy Server ID (needs Developer Mode on).
FEATURE_BOT_GUILD_ID=

# Each role below is independently optional -- unset (no ID and default
# name not found) just means that one role is skipped, not an error, so
# these 3 can be turned on one at a time. Preferred: the numeric Role ID
# (Server Settings -> Roles -> right-click -> Copy Role ID, stable across
# renames). Falls back to an exact name match against *_ROLE_NAME (or its
# default) if the ID var is unset.
TOP6_ROLE_ID=
TOP6_ROLE_NAME=Top 6
CHAMPS_ROLE_ID=
CHAMPS_ROLE_NAME=Champs
CURRENT_CHAMP_ROLE_ID=
CURRENT_CHAMP_ROLE_NAME=Current Champ

# Base URL for dashboard-api (same variable stat-bot already uses). Default
# below is correct for the docker-compose deploy; only override for local
# testing against a differently-hosted API.
DASHBOARD_API_BASE_URL=http://dashboard-api:8090

# One-time Discord-server setup this .env alone can't do for you, per role
# you actually configure above:
#   1. Create the role in the server (or reuse an existing one).
#   2. Drag the bot's own role ABOVE it in Server Settings -> Roles.
#   3. Grant the bot the "Manage Roles" permission.
# Discord's API silently refuses role edits below a bot's own hierarchy
# position regardless of permission flags, so step 2 can't be skipped.
