# Copy this to discord/.env and fill in values.
# discord/.env is gitignored.

DISCORD_BOT_TOKEN=your_discord_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here
DISCORD_QA_MODEL=gpt-4.1-mini
# Optional: comma-separated guild IDs for instant slash command registration in specific servers.
# If omitted, commands register globally (can take time to appear).
DISCORD_TEST_GUILD_IDS=
# Optional: comma-separated text channel IDs where bot is allowed to respond.
# If omitted, bot responds in any channel where it has access.
DISCORD_ALLOWED_CHANNEL_IDS=

# LLM usage controls (optional)
# 0 = unlimited monthly tokens for LLM calls
DISCORD_LLM_MAX_TOKENS_MONTH=0
# Upper bound per LLM response
DISCORD_LLM_MAX_OUTPUT_TOKENS=300
# Enable per-LLM-call token logging to discord/llm_request_log.jsonl
DISCORD_LLM_LOG_REQUESTS=0
# Max chars stored from each question in request log
DISCORD_LLM_LOG_MAX_QUESTION_CHARS=240
