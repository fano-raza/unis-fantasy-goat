# Copy this to discord/.env and fill in values.
# discord/.env is gitignored.

DISCORD_BOT_TOKEN=your_discord_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here
DISCORD_QA_MODEL=gpt-4.1-mini
# Optional: comma-separated guild IDs for instant slash command registration in specific servers.
# If omitted, commands register globally (can take time to appear).
DISCORD_TEST_GUILD_IDS=
# Optional: comma-separated text channel IDs where bot is allowed to respond.
# If omitted, bot responds in any channel where it has access.
DISCORD_ALLOWED_CHANNEL_IDS=

# LLM usage controls (optional)
# 0 = unlimited monthly tokens for LLM calls
DISCORD_LLM_MAX_TOKENS_MONTH=0
# Upper bound per LLM response
DISCORD_LLM_MAX_OUTPUT_TOKENS=300

# Bot usage logging (request-level audit)
# 0 = enabled, 1 = disable usage logging
DISCORD_USAGE_LOG_DISABLE=0
# Max chars persisted per field in usage log
DISCORD_USAGE_LOG_MAX_QUESTION_CHARS=500
DISCORD_USAGE_LOG_MAX_RESPONSE_CHARS=300
# Reply-to-bot feedback flow:
# 1 = react with 📝 when feedback reply is captured; 0 = silent capture
DISCORD_FEEDBACK_ACK=1
# Optional CSV for Discord user -> team mapping.
# Format: discord/discord_names.csv with headers:
# discord_user_id,discord_name,team
DISCORD_USER_TEAM_MAP_CSV=
# Enable per-LLM-call token logging to discord/llm_request_log.jsonl
DISCORD_LLM_LOG_REQUESTS=0
# Max chars stored from each question in request log
DISCORD_LLM_LOG_MAX_QUESTION_CHARS=240
# Minimum confidence required to accept LLM parse plan (0..1)
DISCORD_LLM_PARSE_CONFIDENCE=0.35
# 0 = keep deterministic routed parse when available (recommended)
# 1 = allow high-confidence LLM parse to override routed parse
DISCORD_LLM_OVERRIDE_ROUTED=0
