# Local environment files
.env
.env.*
!*.env.example
# Real per-service env files (secrets, e.g. the Roster Optimizer password)
# exist only on the droplet -- never commit them.
infra/docker/env/*.env
!**/*.env.example

# Discord bot local secrets
discord/.env

# Yahoo Fantasy API app credentials (consumer_key/consumer_secret/refresh_token)
private.json

# Python cache
__pycache__/
*.py[cod]

# macOS
.DS_Store
