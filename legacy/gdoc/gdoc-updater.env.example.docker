# Copy to infra/docker/env/gdoc-updater.env and fill values.

# Core runtime dirs (inside container)
FANTASY_DATA_ROOT=/srv/unisfantasy/data
FANTASY_REF_DIR=/srv/unisfantasy/data/ref
GOOGLE_SERVICE_ACCOUNT_JSON=/srv/unisfantasy/secrets/google-service-account.json

# Updater server settings
GDOC_UPDATER_HOST=0.0.0.0
GDOC_UPDATER_PORT=5000
GDOC_UPDATER_DEBUG=0

# Optional auth overrides
ESPN_S2=
ESPN_SWID=
YAHOO_KEY=
YAHOO_SECRET=

# Optional webhook
DISCORD_WEBHOOK_URL=
