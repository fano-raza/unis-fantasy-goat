FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Separate, lighter requirements than infra/docker/Dockerfile's
# requirements-deploy.txt (gspread/sklearn/disnake/aiohttp/yahoo_oauth) --
# dashboard_site is deliberately decoupled from the heavy Models/constants
# path (see _planning/web-app-build-plan.md's "Session 3" notes) and only
# needs fastapi/uvicorn/pandas/numpy/pydantic.
COPY dashboard_site/requirements.txt /tmp/requirements-dashboard.txt
RUN pip install --no-cache-dir -r /tmp/requirements-dashboard.txt

COPY . /app

CMD ["uvicorn", "dashboard_site.api.app:app", "--host", "0.0.0.0", "--port", "8090"]
