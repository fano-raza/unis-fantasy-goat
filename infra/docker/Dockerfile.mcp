FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Smallest image of the stack: the MCP server only proxies dashboard-api over
# HTTP, so no pandas/numpy/Models (see mcp_server/server.py's docstring).
COPY mcp_server/requirements.txt /tmp/requirements-mcp.txt
RUN pip install --no-cache-dir -r /tmp/requirements-mcp.txt

COPY mcp_server /app/mcp_server

CMD ["python", "mcp_server/server.py"]
