# dashboard-api service environment. Copy to dashboard-api.env ON THE DROPLET
# only (/opt/unisFantasyGOAT/infra/docker/env/dashboard-api.env); never commit
# the real file.

# Password for POST /league/roster_optimizer (the Roster page's "Optimize
# roster" button). Leave unset to turn the feature off. To change it: edit the
# real file, then `docker compose -f infra/docker/docker-compose.yml up -d
# dashboard-api` (and restart caddy -- see deploy/scripts/server_pull_and_restart.sh).
ROSTER_OPTIMIZER_PASSWORD=change-me
