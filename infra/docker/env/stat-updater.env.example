# Copy to infra/docker/env/stat-updater.env and fill values.

# Core runtime dirs (inside container)
FANTASY_DATA_ROOT=/srv/unisfantasy/data
FANTASY_REF_DIR=/srv/unisfantasy/data/ref
# Not actually used by this service (no Sheets writes happen here), but
# required: constants.py authenticates a Google service account at import
# time unconditionally, so this needs to point somewhere valid just for
# the import to succeed.
GOOGLE_SERVICE_ACCOUNT_JSON=/srv/unisfantasy/secrets/google-service-account.json

# Updater server settings
STAT_UPDATER_HOST=0.0.0.0
STAT_UPDATER_PORT=5001
STAT_UPDATER_DEBUG=0

# Optional auth overrides (ESPN seasons need ESPN_S2/ESPN_SWID, Yahoo
# seasons need YAHOO_KEY/YAHOO_SECRET or a private.json in the working
# directory -- see StatGenerator.py / yfpy_fr/query.py)
ESPN_S2=
ESPN_SWID=
YAHOO_KEY=
YAHOO_SECRET=

# Discord milestone notifications (discord/discord_messages.py::notify_milestones,
# called once per daily update cycle). Defaults to enabled (DISCORD_ENABLE_MILESTONES
# unset == on) -- this was missing from this file entirely before 2026-10-07, which
# silently kept it on in production despite the intent to have it off. Set to 0 here
# so a fresh deploy doesn't regress back to posting.
DISCORD_ENABLE_MILESTONES=0
