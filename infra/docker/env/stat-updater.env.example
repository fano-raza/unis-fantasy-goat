# Copy to infra/docker/env/stat-updater.env and fill values.

# Core runtime dirs (inside container)
FANTASY_DATA_ROOT=/srv/unisfantasy/data
FANTASY_REF_DIR=/srv/unisfantasy/data/ref

# Updater server settings
STAT_UPDATER_HOST=0.0.0.0
STAT_UPDATER_PORT=5001
STAT_UPDATER_DEBUG=0

# Optional auth overrides (ESPN seasons need ESPN_S2/ESPN_SWID, Yahoo
# seasons need YAHOO_KEY/YAHOO_SECRET or a private.json in the working
# directory -- see StatGenerator.py / yfpy_fr/query.py)
ESPN_S2=
ESPN_SWID=
YAHOO_KEY=
YAHOO_SECRET=
