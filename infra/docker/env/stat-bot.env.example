# Copy to infra/docker/env/stat-bot.env and fill in STAT_BOT_TOKEN.

STAT_BOT_TOKEN=

# Internal compose network hostname -- dashboard-api isn't exposed on a
# host port, only reachable at this address from other containers.
DASHBOARD_API_BASE_URL=http://dashboard-api:8090

# Optional: comma-separated guild IDs for instant slash command registration
# in specific servers. If omitted, commands register globally (can take a
# while to appear).
DISCORD_TEST_GUILD_IDS=

# Optional temporary TLS bypass (not recommended long-term)
DISCORD_SSL_NO_VERIFY=0
