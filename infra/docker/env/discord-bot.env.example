# Copy to infra/docker/env/discord-bot.env and fill values.

# Core runtime dirs (inside container)
FANTASY_DATA_ROOT=/srv/unisfantasy/data
FANTASY_REF_DIR=/srv/unisfantasy/data/ref
GOOGLE_SERVICE_ACCOUNT_JSON=/srv/unisfantasy/secrets/google-service-account.json

DISCORD_BOT_TOKEN=
OPENAI_API_KEY=
DISCORD_QA_MODEL=gpt-4.1-mini

# Slash command registration + channel controls
DISCORD_TEST_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=

# LLM controls
DISCORD_LLM_MAX_TOKENS_MONTH=0
DISCORD_LLM_MAX_OUTPUT_TOKENS=300
DISCORD_LLM_LOG_REQUESTS=0
DISCORD_LLM_LOG_MAX_QUESTION_CHARS=240

# Optional temporary TLS bypass (not recommended long-term)
DISCORD_SSL_NO_VERIFY=0
