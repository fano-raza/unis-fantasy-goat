# Copy to infra/docker/env/feature-bot.env and fill in FEATURE_BOT_TOKEN.

# Core runtime dirs (inside container) -- same volume the other services
# already mount, so feature_requests.md (and top6_role_last_run.txt) land
# in the same persistent data directory as everything else.
FANTASY_DATA_ROOT=/srv/unisfantasy/data

FEATURE_BOT_TOKEN=

# --- Top 6 role (weekly standings-synced Discord role) --- see the fuller
# comment in discord/feature_bot.env.example for the required one-time
# Discord-server setup (role must exist, bot role above it, Manage Roles
# permission).
FEATURE_BOT_GUILD_ID=
TOP6_ROLE_ID=
TOP6_ROLE_NAME=Top 6
DASHBOARD_API_BASE_URL=http://dashboard-api:8090

# Optional temporary TLS bypass (not recommended long-term)
DISCORD_SSL_NO_VERIFY=0
