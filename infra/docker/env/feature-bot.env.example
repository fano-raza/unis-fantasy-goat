# Copy to infra/docker/env/feature-bot.env and fill in FEATURE_BOT_TOKEN.

# Core runtime dirs (inside container) -- same volume the other services
# already mount, so feature_requests.md (and weekly_role_sync_last_run.txt)
# land in the same persistent data directory as everything else.
FANTASY_DATA_ROOT=/srv/unisfantasy/data

FEATURE_BOT_TOKEN=

# --- Weekly role sync (Top 6 / Champs / Current Champ) --- see the fuller
# comment in discord/feature_bot.env.example for the required one-time
# Discord-server setup per role (must exist, bot role above it, Manage
# Roles permission) and how the *_ROLE_ID/*_ROLE_NAME fallback works.
FEATURE_BOT_GUILD_ID=
TOP6_ROLE_ID=
TOP6_ROLE_NAME=Top 6
CHAMPS_ROLE_ID=
CHAMPS_ROLE_NAME=Champs
CURRENT_CHAMP_ROLE_ID=
CURRENT_CHAMP_ROLE_NAME=Current Champ
DASHBOARD_API_BASE_URL=http://dashboard-api:8090

# Optional temporary TLS bypass (not recommended long-term)
DISCORD_SSL_NO_VERIFY=0
