# Copy to infra/docker/env/feature-bot.env and fill in FEATURE_BOT_TOKEN.

# Core runtime dirs (inside container) -- same volume the other services
# already mount, so feature_requests.md lands in the same persistent data
# directory as everything else.
FANTASY_DATA_ROOT=/srv/unisfantasy/data

FEATURE_BOT_TOKEN=

# Optional temporary TLS bypass (not recommended long-term)
DISCORD_SSL_NO_VERIFY=0
